{
  "name": "humanwriter-scraper",
  "version": "1.0.0",
  "description": "HumanWriter AI - Academic Document Scraper",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "scrape": "ts-node src/index.ts",
    "scrape:universidades": "ts-node src/index.ts --category=universidades",
    "scrape:instituciones": "ts-node src/index.ts --category=instituciones",
    "scrape:organismos": "ts-node src/index.ts --category=organismos",
    "scrape:journals": "ts-node src/index.ts --category=journals",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "puppeteer": "^24.35.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.1",
    "@prisma/client": "^7.1.0",
    "dotenv": "^16.4.7",
    "winston": "^3.18.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.1",
    "user-agents": "^1.1.401",
    "mime-types": "^2.1.35",
    "fs-extra": "^11.2.0",
    "natural": "^8.0.1",
    "compromise": "^14.14.5",
    "date-fns": "^4.1.0",
    "chalk": "^5.4.1",
    "ora": "^8.2.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/fs-extra": "^11.0.4",
    "@types/mime-types": "^2.1.4",
    "typescript": "^5.9.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "prisma": "^7.1.0",
    "eslint": "^9.18.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0"
  }
}
