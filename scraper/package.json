{
  "name": "humanwriter-scraper",
  "version": "1.0.0",
  "description": "HumanWriter AI - Academic Document Scraper",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "scrape": "ts-node src/index.ts",
    "scrape:universidades": "ts-node src/index.ts --category=universidades",
    "scrape:instituciones": "ts-node src/index.ts --category=instituciones",
    "scrape:organismos": "ts-node src/index.ts --category=organismos",
    "scrape:journals": "ts-node src/index.ts --category=journals",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "puppeteer": "^21.7.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.1.0",
    "user-agents": "^1.1.79",
    "mime-types": "^2.1.35",
    "fs-extra": "^11.2.0",
    "natural": "^6.10.4",
    "compromise": "^14.10.0",
    "date-fns": "^3.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/puppeteer": "^7.0.4",
    "@types/pdf-parse": "^1.1.4",
    "@types/fs-extra": "^11.0.4",
    "@types/mime-types": "^2.1.4",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.7.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0"
  }
}
