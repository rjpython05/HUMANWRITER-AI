# ===========================================
# HUMANWRITER AI - Environment Variables
# ===========================================

# -----------------
# Database
# -----------------
DATABASE_URL="postgresql://humanwriter:dev_password@localhost:5432/humanwriter_db"
POSTGRES_USER="humanwriter"
POSTGRES_PASSWORD="dev_password"
POSTGRES_DB="humanwriter_db"

# -----------------
# Redis
# -----------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# -----------------
# ChromaDB
# -----------------
CHROMADB_HOST="localhost"
CHROMADB_PORT="8000"

# -----------------
# Ollama
# -----------------
OLLAMA_HOST="http://localhost:11434"
OLLAMA_NUM_PARALLEL="1"
MODEL_NAME="llama3.1:8b"

# -----------------
# NextAuth.js
# -----------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Generate with: openssl rand -base64 32

# -----------------
# API Configuration
# -----------------
API_URL="http://localhost:3001"
AI_ENGINE_URL="http://localhost:8001"
BACKEND_PORT="3001"
AI_ENGINE_PORT="8001"

# -----------------
# JWT Configuration
# -----------------
JWT_SECRET="your-jwt-secret-change-this"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# -----------------
# Application
# -----------------
NODE_ENV="development"
APP_NAME="HumanWriter AI"
APP_URL="http://localhost:3000"

# -----------------
# File Storage
# -----------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="52428800"
ALLOWED_FILE_TYPES=".pdf,.docx,.doc,.txt"

# -----------------
# Scraper Configuration
# -----------------
SCRAPER_DATA_DIR="./scraper/data"
SCRAPER_MAX_CONCURRENT="5"
SCRAPER_RATE_LIMIT_MS="2000"
SCRAPER_MAX_RETRIES="3"

# -----------------
# Fine-tuning Configuration
# -----------------
FINE_TUNE_TRIGGER_THRESHOLD="50"
COLAB_NOTEBOOK_URL=""
HUGGINGFACE_TOKEN=""

# -----------------
# Email Configuration (Future)
# -----------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@humanwriter.ai"

# -----------------
# OAuth Providers (Future - Production)
# -----------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# -----------------
# Payment Processing (Future)
# -----------------
# STRIPE_PUBLIC_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# -----------------
# Cloud Storage (Future - Production)
# -----------------
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET="humanwriter-storage"

# -----------------
# Monitoring (Future)
# -----------------
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# -----------------
# CORS Configuration
# -----------------
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"

# -----------------
# Logging
# -----------------
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
