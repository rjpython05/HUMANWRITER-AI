# ===========================================
# HUMANWRITER AI - Environment Variables
# ===========================================

# -----------------
# Database
# -----------------
# SECURITY: Change these credentials in production!
DATABASE_URL="postgresql://humanwriter:CHANGE_THIS_PASSWORD@localhost:5432/humanwriter_db"
POSTGRES_USER="humanwriter"
POSTGRES_PASSWORD="CHANGE_THIS_PASSWORD"
POSTGRES_DB="humanwriter_db"

# -----------------
# Redis
# -----------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# -----------------
# ChromaDB
# -----------------
CHROMADB_HOST="localhost"
CHROMADB_PORT="8000"

# -----------------
# Ollama
# -----------------
OLLAMA_HOST="http://localhost:11434"
OLLAMA_NUM_PARALLEL="1"
MODEL_NAME="llama3.1:8b"

# -----------------
# NextAuth.js
# -----------------
NEXTAUTH_URL="http://localhost:3000"
# CRITICAL SECURITY: Generate a strong secret with: openssl rand -base64 32
# Never use the default value in production!
NEXTAUTH_SECRET="CHANGE_THIS_GENERATE_WITH_OPENSSL"

# -----------------
# API Configuration
# -----------------
API_URL="http://localhost:3001"
AI_ENGINE_URL="http://localhost:8001"
BACKEND_PORT="3001"
AI_ENGINE_PORT="8001"

# -----------------
# JWT Configuration
# -----------------
# CRITICAL SECURITY: Generate a strong secret with: openssl rand -base64 32
# Must be at least 32 characters long!
JWT_SECRET="CHANGE_THIS_GENERATE_WITH_OPENSSL"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# -----------------
# Application
# -----------------
NODE_ENV="development"
APP_NAME="HumanWriter AI"
APP_URL="http://localhost:3000"

# -----------------
# File Storage
# -----------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="52428800"
ALLOWED_FILE_TYPES=".pdf,.docx,.doc,.txt"

# -----------------
# Scraper Configuration
# -----------------
SCRAPER_DATA_DIR="./scraper/data"
SCRAPER_MAX_CONCURRENT="5"
SCRAPER_RATE_LIMIT_MS="2000"
SCRAPER_MAX_RETRIES="3"

# -----------------
# Fine-tuning Configuration
# -----------------
FINE_TUNE_TRIGGER_THRESHOLD="50"
COLAB_NOTEBOOK_URL=""
HUGGINGFACE_TOKEN=""

# -----------------
# Email Configuration (Future)
# -----------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@humanwriter.ai"

# -----------------
# OAuth Providers (Future - Production)
# -----------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# -----------------
# Payment Processing (Future)
# -----------------
# STRIPE_PUBLIC_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# -----------------
# Cloud Storage (Future - Production)
# -----------------
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
# S3_BUCKET="humanwriter-storage"

# -----------------
# Monitoring (Future)
# -----------------
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS="100"

# -----------------
# Security Settings
# -----------------
BCRYPT_ROUNDS="12"  # Number of bcrypt hashing rounds (10-14 recommended)
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION="15"  # Minutes
SESSION_SECRET="CHANGE_THIS_GENERATE_WITH_OPENSSL"

# -----------------
# CORS Configuration
# -----------------
CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS="true"

# -----------------
# Logging
# -----------------
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
